  "mechanism": {
    "name": "constant learning rate with permanently saturated gradient clipping",
    "evidence": "Every logged step in both arms is clipped: 100% of steps exceed the 1.0 clip in the plain arm (norm median 35.86, max 109.17) and in the decay arm (median 26.69, max 286.58). Clipping rescales every update to unit norm, so the weight change is lr x unit direction: a fixed-size step that cannot shrink near the optimum. Loss stays flat (4.9-8.8) with no downward trend after 1,000 steps, the swept best threshold wanders by 4.5 logits, and geometry oscillates 1.11 -> 0.75 -> 0.66 -> 0.83 cells.",
    "ruled_out": [
      "memorisation of the fixed pool (held-out beats seen)",
      "non-finite weights (zero non-finite tensors in every saved state)",
      "pool staleness as repeated samples (the pool is the training split itself and the held-out split still outperforms it)"
    ]
  },
  "fix": {
    "change": "cosine decay of the learning rate from 1e-3 to 1e-4 across the arm",
    "why_smallest": "The mechanism is a fixed update magnitude, so the minimal change is to make that magnitude shrink; no architecture, data or loss change is implied by the evidence.",
